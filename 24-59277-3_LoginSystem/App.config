<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
  </startup>

  <!--
    Edit ONLY the values below if your lab PC's SQL Server instance name
    or database name is different. Nothing else in the project needs to change,
    because every form reads this value through ConfigurationManager instead
    of hard-coding it.

    Data Source        = which SQL Server instance to connect to
    Initial Catalog     = which database to use
    Integrated Security  = True means "log in as my Windows account"
    Connect Timeout     = how many seconds to wait before giving up
  -->
  <connectionStrings>
    <add name="LoginDbConnection"
         connectionString="Data Source=.\SQLEXPRESS;Initial Catalog=24-59277-3_LoginDB;Integrated Security=True;Connect Timeout=30"
         providerName="System.Data.SqlClient" />
  </connectionStrings>
</configuration>
